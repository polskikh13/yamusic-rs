component SortItem inherits Rectangle {
    in property <string> text;
    in property <int> value;
    height: 56px;
    Text {
        x: 16px;
        text: root.text;
        color: T.fg.with-alpha(0.90);
        font-size: 16px;
        vertical-alignment: center;
    }
    if Pages.sort == root.value: Image {
        x: parent.width - 40px;
        width: 24px;
        height: 24px;
        source: Now.icons.check;
        colorize: T.fg;
    }
    TouchArea {
        clicked => {
            Pages.sort = root.value;
            Pages.sort-open = false;
            Pages.sort-picked(root.value);
        }
    }
}

/// Сортировка «Моих плейлистов», как шторка оригинала.
