// Шторки плеера на светлом фоне: меню трека, настройки звука, таймер сна.

import { Now, Sheet, Cover, QualityOption, T } from "common.slint";
import { Pages } from "pages.slint";

component MenuItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> grey;
    callback clicked();
    height: 48px;
    Image {
        x: 22.4px;
        width: 24px;
        height: 24px;
        source: root.icon;
        colorize: root.grey ? T.fg.with-alpha(0.55) : T.fg.with-alpha(0.90);
    }
    Text {
        x: 60px;
        text: root.text;
        color: root.grey ? T.fg.with-alpha(0.55) : T.fg.with-alpha(0.90);
        font-size: 17px;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component RoundItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <color> tint: T.fg.with-alpha(0.90);
    callback clicked();
    width: 96px;
    height: 112px;
    Rectangle {
        x: 16px;
        y: 0;
        width: 64px;
        height: 64px;
        border-radius: 32px;
        background: T.fg.with-alpha(0.06);
        Image {
            width: 28px;
            height: 28px;
            source: root.icon;
            colorize: root.tint;
        }
    }
    Text {
        y: 76px;
        width: parent.width;
        text: root.text;
        color: T.fg.with-alpha(0.90);
        font-size: 15px;
        horizontal-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

/// Меню «⋮» трека из списка.
export component TrackSheet inherits Sheet {
    open <=> Pages.menu-open;
    panel-height: 772px;
    Cover {
        x: 16px;
        y: 38.4px;
        width: 80px;
        height: 80px;
        radius: 8px;
        source: Pages.menu-track.cover;
    }
    Text {
        x: 108px;
        y: 55px;
        width: parent.width - 124px;
        text: Pages.menu-track.title;
        color: T.fg;
        font-size: 22px;
        font-weight: 700;
        overflow: elide;
    }
    Text {
        x: 108px;
        y: 84px;
        width: parent.width - 124px;
        text: Pages.menu-track.subtitle;
        color: T.fg.with-alpha(0.55);
        font-size: 15px;
        overflow: elide;
    }
    Rectangle {
        x: 16px;
        y: 140px;
        width: parent.width - 32px;
        height: 64px;
        border-radius: 16px;
        clip: true;
        background: @linear-gradient(170deg, #2b2626 0%, #110f0f 50%, #3a3535 100%);
        Text {
            y: 10px;
            width: parent.width;
            text: "Моя волна по треку";
            color: #ffffffb3;
            font-size: 15px;
            font-weight: 500;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            y: 27px;
            height: 28px;
            alignment: center;
            spacing: 4px;
            Image {
                y: 4px;
                width: 20px;
                height: 20px;
                source: Now.icons.play-small;
                colorize: #fff;
            }
            Text {
                text: Pages.menu-track.title;
                color: #fff;
                font-family: "YS Music Headline";
                font-weight: 700;
                font-size: 21px;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        TouchArea {
            clicked => {
                root.open = false;
                Pages.menu-action(0);
            }
        }
    }
    RoundItem {
        x: parent.width / 2 - 144px;
        y: 232px;
        icon: Pages.menu-liked ? Now.icons.liked : Now.icons.like;
        tint: Pages.menu-liked ? #f2c200 : T.fg.with-alpha(0.90);
        text: "Нравится";
        clicked => { Pages.menu-action(1); }
    }
    RoundItem {
        x: parent.width / 2 - 48px;
        y: 232px;
        icon: Now.icons.play-small;
        text: "Следующим";
        clicked => {
            root.open = false;
            Pages.menu-action(2);
        }
    }
    RoundItem {
        x: parent.width / 2 + 48px;
        y: 232px;
        icon: Now.icons.queue;
        text: "В очередь";
        clicked => {
            root.open = false;
            Pages.menu-action(3);
        }
    }
    MenuItem {
        y: 352px;
        icon: Now.icons.share;
        text: "Поделиться";
        clicked => {
            root.open = false;
            Pages.menu-action(4);
        }
    }
    MenuItem {
        y: 400px;
        icon: Now.icons.download;
        text: "Скачать";
        clicked => {
            root.open = false;
            Pages.menu-action(9);
        }
    }
    MenuItem {
        y: 448px;
        icon: Now.icons.add;
        text: "Добавить в плейлист";
        clicked => {
            root.open = false;
            Pages.pick-open = true;
        }
    }
    MenuItem {
        y: 496px;
        icon: Now.icons.album;
        text: "Перейти к альбому";
        clicked => {
            root.open = false;
            Pages.menu-action(6);
        }
    }
    MenuItem {
        y: 544px;
        icon: Now.icons.listeners;
        text: "Перейти к исполнителю";
        clicked => {
            root.open = false;
            Pages.menu-action(7);
        }
    }
    MenuItem {
        y: 592px;
        icon: Now.icons.info;
        text: "О треке";
        clicked => {
            root.open = false;
            Pages.menu-action(10);
        }
    }
    Rectangle {
        x: 16px;
        y: 652px;
        width: parent.width - 32px;
        height: 1px;
        background: T.fg.with-alpha(0.10);
    }
    MenuItem {
        y: 660px;
        icon: Now.icons.dislike;
        text: Pages.menu-disliked ? "Убрать из «Не нравится»" : "Не нравится";
        grey: !Pages.menu-disliked;
        clicked => {
            root.open = false;
            Pages.menu-action(8);
        }
    }
}

/// Выбор плейлиста для трека из меню.
export component PickSheet inherits Sheet {
    open <=> Pages.pick-open;
    panel-height: min(root.height * 0.7, 88px + Now.playlists.length * 72px);
    Text {
        x: 16px;
        y: 30px;
        text: "Добавить в плейлист";
        color: T.fg;
        font-size: 22px;
        font-weight: 700;
    }
    Flickable {
        y: 76px;
        height: root.panel-height - 76px;
        content-height: Now.playlists.length * 72px;
        for row[i] in Now.playlists: Rectangle {
            y: i * 72px;
            height: 72px;
            Cover {
                x: 16px;
                y: 8px;
                width: 56px;
                height: 56px;
                source: row.cover;
            }
            Text {
                x: 84px;
                y: 16px;
                width: parent.width - 100px;
                text: row.title;
                color: T.fg;
                font-size: 17px;
                font-weight: 500;
                overflow: elide;
            }
            Text {
                x: 84px;
                y: 40px;
                width: parent.width - 100px;
                text: row.subtitle;
                color: T.fg.with-alpha(0.55);
                font-size: 14px;
                overflow: elide;
            }
            TouchArea {
                clicked => {
                    root.open = false;
                    Pages.pick(i);
                }
            }
        }
    }
}

/// «О треке»: название, исполнители и участники записи.
export component AboutSheet inherits Sheet {
    open <=> Pages.about-open;
    panel-height: 150px + max(1, Pages.about-roles.length) * 60px;
    Text {
        x: 16px;
        y: 30px;
        text: "О треке";
        color: T.fg;
        font-size: 22px;
        font-weight: 700;
    }
    Text {
        x: 16px;
        y: 70px;
        width: parent.width - 32px;
        text: Pages.about-title;
        color: T.fg;
        font-size: 17px;
        font-weight: 500;
        overflow: elide;
    }
    Text {
        x: 16px;
        y: 94px;
        width: parent.width - 32px;
        text: Pages.about-artists;
        color: T.fg.with-alpha(0.55);
        font-size: 15px;
        overflow: elide;
    }
    if Pages.about-roles.length == 0: Text {
        x: 16px;
        y: 134px;
        width: parent.width - 32px;
        text: Pages.about-status;
        color: T.fg.with-alpha(0.55);
        font-size: 15px;
    }
    for role[i] in Pages.about-roles: Rectangle {
        y: 130px + i * 60px;
        height: 60px;
        Text {
            x: 16px;
            y: 8px;
            width: parent.width - 32px;
            text: role;
            color: T.fg.with-alpha(0.55);
            font-size: 13px;
            overflow: elide;
        }
        Text {
            x: 16px;
            y: 28px;
            width: parent.width - 32px;
            text: Pages.about-names[i];
            color: T.fg;
            font-size: 17px;
            overflow: elide;
        }
    }
}

export component ArtistsSheet inherits Sheet {
    open <=> Pages.artists-open;
    panel-height: 112px + Pages.artist-names.length * 56px;
    Text {
        x: 16px;
        y: 30px;
        text: "Исполнители";
        color: T.fg;
