        font-weight: 700;
    }
    for name[i] in Pages.artist-names: Rectangle {
        y: 76px + i * 56px;
        height: 56px;
        Text {
            x: 16px;
            width: parent.width - 32px;
            text: name;
            color: T.fg;
            font-size: 17px;
            font-weight: 500;
            overflow: elide;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => {
                root.open = false;
                Pages.pick-artist(i);
            }
        }
    }
}

