    open <=> Pages.sort-open;
    panel-height: 288px;
    Text {
        y: 30px;
        width: parent.width;
        text: "Сортировка";
        color: T.fg;
        font-family: "YS Music Headline";
        font-weight: 700;
        font-size: 22px;
        horizontal-alignment: center;
    }
    Rectangle {
        x: 12px;
        y: 84px;
        width: parent.width - 24px;
        height: 170px;
        border-radius: 12px;
        background: T.fg.with-alpha(0.06);
        VerticalLayout {
            SortItem { text: "По дате добавления"; value: 0; }
            Rectangle { height: 1px; background: T.fg.with-alpha(0.08); }
            SortItem { text: "Недавно обновлённые"; value: 1; }
            Rectangle { height: 1px; background: T.fg.with-alpha(0.08); }
            SortItem { text: "По алфавиту"; value: 2; }
        }
    }
}

export component QualitySheet inherits Sheet {
    panel-height: 470px;
    Text {
        y: 38px;
        width: parent.width;
        text: "Настройки звука";
        color: T.fg;
        font-family: "YS Music Headline";
        font-weight: 700;
        font-size: 22px;
        horizontal-alignment: center;
    }
    QualityOption {
        y: 94px;
        height: 88px;
        width: parent.width;
        title: "Автоматическое";
        text: "Звук автоматически подстраивается под текущее качество вашей сети";
        checked: Now.quality == 0;
        clicked => { Now.set-quality(0); }
    }
    QualityOption {
        y: 182.2px;
        height: 103px;
        width: parent.width;
        title: "Превосходное";
        text: "Музыка в lossless и других высококачественных форматах — для безлимитного интернета и хорошей акустики";
        checked: Now.quality == 1;
        clicked => { Now.set-quality(1); }
    }
    QualityOption {
        y: 285.4px;
        height: 88px;
        width: parent.width;
        title: "Оптимальное";
        text: "Сбалансированный звук для большинства устройств, со средним расходом трафика";
        checked: Now.quality == 2;
        clicked => { Now.set-quality(2); }
    }
    QualityOption {
        y: 373.4px;
        height: 70px;
        width: parent.width;
        title: "Экономичное";
        text: "Для медленного интернета, с минимальным расходом трафика";
        checked: Now.quality == 3;
        clicked => { Now.set-quality(3); }
    }
}

export component TimerSheet inherits Sheet {
    in-out property <int> minutes: 30;
    in-out property <bool> end-of-track;
    // Центр циферблата и радиусы кольца и подписей.
    property <length> cx: self.width / 2;
    property <length> cy: 325.8px;
    property <length> r: 132px;
    property <float> turn: min(root.minutes, 59.99) / 60;
    panel-height: 602px;

    Text {
        y: 47px;
        width: parent.width;
        text: "Таймер сна";
        color: T.fg;
        font-family: "YS Music Headline";
        font-weight: 700;
        font-size: 22px;
        horizontal-alignment: center;
    }
    Text {
        x: 20.4px;
        y: 116.9px;
        text: "Конец трека или выпуска";
        color: T.fg.with-alpha(0.90);
        font-size: 16px;
    }
    Rectangle {
        x: parent.width - 54px;
        y: 117px;
        width: 34px;
        height: 24px;
        Rectangle {
            y: 5px;
            height: 14px;
            border-radius: 7px;
            background: root.end-of-track ? T.fg.with-alpha(0.70) : T.fg.with-alpha(0.30);
        }
        Rectangle {
            x: root.end-of-track ? parent.width - self.width : 0;
            animate x { duration: 150ms; }
            width: 22px;
            height: 22px;
            y: 1px;
            border-radius: 11px;
            background: #fff;
            drop-shadow-blur: 3px;
            drop-shadow-color: #0000004d;
        }
        TouchArea {
            clicked => { root.end-of-track = !root.end-of-track; }
        }
    }

    // Циферблат: серое кольцо, чёрная дуга от нуля до выбранных минут, кружок на конце.
    Path {
        x: root.cx - root.r;
        y: root.cy - root.r;
        width: 2 * root.r;
        height: 2 * root.r;
        viewbox-width: 2 * root.r / 1px;
        viewbox-height: 2 * root.r / 1px;
        stroke: T.fg.with-alpha(0.08);
        stroke-width: 3px;
        commands: "M " + (root.r / 1px) + " 1.5 A " + (root.r / 1px - 1.5) + " " + (root.r / 1px - 1.5) + " 0 1 1 " + (root.r / 1px - 0.01) + " 1.5";
        opacity: root.end-of-track ? 0.4 : 1;
    }
    if root.minutes > 0: Path {
        x: root.cx - root.r;
        y: root.cy - root.r;
        width: 2 * root.r;
        height: 2 * root.r;
        viewbox-width: 2 * root.r / 1px;
        viewbox-height: 2 * root.r / 1px;
        stroke: #1a1a1a;
        stroke-width: 3px;
        commands: "M " + (root.r / 1px) + " 1.5 A " + (root.r / 1px - 1.5) + " " + (root.r / 1px - 1.5) + " 0 " + (root.turn > 0.5 ? 1 : 0) + " 1 " + (root.r / 1px + (root.r / 1px - 1.5) * Math.sin(root.turn * 360deg)) + " " + (root.r / 1px - (root.r / 1px - 1.5) * Math.cos(root.turn * 360deg));
        opacity: root.end-of-track ? 0.4 : 1;
    }
    Rectangle {
        x: root.cx + (root.r - 1.5px) * Math.sin(root.turn * 360deg) - self.width / 2;
        y: root.cy - (root.r - 1.5px) * Math.cos(root.turn * 360deg) - self.height / 2;
        width: 19px;
        height: 19px;
        border-radius: 9.5px;
        background: #1a1a1a;
        opacity: root.end-of-track ? 0.4 : 1;
    }
    for i in 12: Text {
        x: root.cx + 160px * Math.sin(i * 30deg) - 20px;
        y: root.cy - 160px * Math.cos(i * 30deg) - 12px;
        width: 40px;
        height: 24px;
        text: i * 5;
        color: T.fg.with-alpha(0.55);
        font-size: 17px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        y: root.cy - 30px;
        width: parent.width;
        height: 60px;
        text: Now.timer-on ? Now.timer-left : (root.minutes < 10 ? "0" : "") + root.minutes + ":00";
        color: T.fg;
        font-family: T.display-font;
        font-weight: 700;
        font-size: 40px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        x: root.cx - root.r - 40px;
        y: root.cy - root.r - 40px;
        width: 2 * root.r + 80px;
        height: 2 * root.r + 80px;
        enabled: !root.end-of-track && !Now.timer-on;
        moved => {
            if self.pressed {
                let a = Math.atan2((self.mouse-x - self.width / 2) / 1px, (self.height / 2 - self.mouse-y) / 1px) / 1deg;
                root.minutes = Math.round((a < 0 ? a + 360 : a) / 6);
            }
        }
    }

    Rectangle {
        x: (parent.width - 253px) / 2;
        y: 523px;
        width: 253px;
        height: 47px;
        border-radius: 23.5px;
        background: go.pressed ? #f0d400 : #ffe100;
        Text {
            text: Now.timer-on ? "Остановить" : "Запустить";
            color: #000;
            font-size: 17px;
            font-weight: 500;
        }
        go := TouchArea {
            clicked => {
                if Now.timer-on {
                    Now.stop-timer();
                } else if root.end-of-track || root.minutes > 0 {
                    Now.start-timer(root.minutes, root.end-of-track);
                    root.open = false;
                }
            }
        }
    }
}
