// «Моя волна»: колесо вайбов, кнопка запуска и фоновое пятно в цветах трека.

import { Theme } from "theme.slint";
import { Icons, Icon, HoverIcon, BarButton, Cover, ScrollBar } from "widgets.slint";
import { T, App, WheelEntry, WaveOption } from "state.slint";
import { VolumePopup } from "popups.slint";

component GlassButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 24px;
    in property <bool> enabled: true;
    out property <bool> hovered: ta.has-hover;
    in property <bool> highlight-icon: hovered;
    /// Колёсико над кнопкой меняет громкость.
    in property <bool> scroll-volume;
    callback clicked;
    width: 48px;
    height: 48px;
    property <bool> ripple;
    property <length> ripple-x;
    property <length> ripple-y;
    property <float> spread: ripple ? 1 : 0;
    animate spread { duration: root.ripple && App.motion ? 600ms : 0ms; easing: linear; }
    border-radius: self.height / 2;
    clip: true;
    background: ta.has-hover && enabled ? #ffffff1a : #ffffff14;
    animate background { duration: App.motion ? Theme.duration-transition : 0ms; easing: ease; }
    if App.motion && spread > 0 && spread < 1: Rectangle {
        width: root.width * 4 * root.spread;
        height: self.width;
        x: root.ripple-x - self.width / 2;
        y: root.ripple-y - self.height / 2;
        border-radius: self.width / 2;
        background: #ffffff.with-alpha(0.09 * (1 - root.spread));
    }
    Icon {
        source: root.icon;
        size: root.icon-size;
        colorize: !root.enabled ? #ffffff14 : root.highlight-icon ? #e6e6e6 : #ffffffb3;
        animate colorize { duration: App.motion ? Theme.duration-transition : 0ms; easing: ease; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        scroll-event(e) => {
            if !root.scroll-volume {
                return reject;
            }
            App.set-volume(App.wheel-volume(e.delta-y));
            accept
        }
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.ripple = false;
            }
        }
        clicked => {
            root.ripple-x = self.mouse-x;
            root.ripple-y = self.mouse-y;
            root.ripple = true;
            root.clicked();
        }
    }
}

// Слот колеса. `p` — расстояние от центра в слайдах; сдвиг и прозрачность — формула оригинала.
component WheelSlot inherits Rectangle {
    in property <WheelEntry> entry;
    in property <float> p;
    in property <length> slide-h;
    in property <length> wrap-x;
    in property <length> area-h;
    in property <length> area-w;
    in property <length> pointer-x;
    in property <length> pointer-y;
    callback clicked;

    property <float> t: abs(p) / 4;
    property <float> f: t <= 1 ? 3.14159265 - t * 1.57079633 : t <= 2 ? 1.57079633 - (t - 1) * 1.57079633 : 0;
    property <float> a: min(t / 2, 1);
    property <float> s: max(0, min(1, (a - 0.42) / 0.58));
    property <length> yc: area-h / 2 + p * slide-h;
    // Маска оригинала: прозрачные 15% сверху и снизу.
    property <float> edge: yc < area-h * 0.15 ? yc / (area-h * 0.15) : yc > area-h * 0.85 ? (area-h - yc) / (area-h * 0.15) : 1;

    x: wrap-x + 120px * (1 + cos(f * 1rad));
    y: yc - 40px;
    width: area-w - wrap-x;
    height: 80px;
    // Прозрачность раздаётся детям: opacity на слоте — слой на каждый слот в каждом кадре.
    property <float> alpha: max(0, edge) * (1 - 0.86 * s * s * (3 - 2 * s));
    visible: alpha > 0.004;

    Cover {
        x: 0;
        width: 80px;
        height: 80px;
        round: entry.round;
        radius: 0;
        background: transparent;
        source: entry.cover;
        alpha: root.alpha;
        if !entry.control-accent: HoverIcon {
            property <bool> hot: abs(root.p) < 2.5 && root.pointer-x >= 0px && root.pointer-x < root.width
                && root.pointer-y >= 0px && root.pointer-y < root.height;
            property <float> reveal: hot ? 1 : 0;
            animate reveal { duration: App.motion ? Theme.duration-transition : 0ms; easing: ease; }
            visible: self.reveal > 0;
            source: Icons.play-filled;
            size: 40px;
            zoomed: hot && abs(root.pointer-x - 40px) < 20px && abs(root.pointer-y - 40px) < 20px;
            alpha: root.alpha * self.reveal;
        }
    }
    VerticalLayout {
        x: 96px;
        width: max(0px, root.width - self.x - 36px);
        alignment: center;
        spacing: 4px;
        if entry.description != "": Text {
            text: entry.description;
            overflow: elide;
            font-size: Theme.font-size-label-m;
            font-weight: 500;
            color: #ffffff.with-alpha(0.5 * root.alpha);
        }
        Text {
            text: entry.name;
            wrap: word-wrap;
            overflow: elide;
            max-height: entry.description != "" ? 60px : 80px;
            font-size: Theme.font-size-label-l;
            font-weight: 500;
            color: (entry.control-accent ? Theme.logo-color-primary-player : #fff).transparentize(1 - root.alpha);
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}


// Заголовок волны: самый крупный размер от 104 до 48, при котором слова не рвутся
// и текст влезает по высоте (не больше 4 строк), — как useDynamicText оригинала.
// С фото исполнителя (`compact`) — от 64 до 24 и не больше двух строк (`iB` оригинала).
component FitTitle inherits Rectangle {
    in property <string> text;
    in property <string> longest;
    in property <bool> link;
    in property <bool> compact;
    callback clicked;

    property <length> w: root.width;
    property <length> h: root.height;
    p104 := Text { visible: false; width: w; text: root.text; wrap: word-wrap; font-family: "YS Music Headline"; font-weight: 700; font-size: 104px; }
    p96 := Text { visible: false; width: w; text: root.text; wrap: word-wrap; font-family: "YS Music Headline"; font-weight: 700; font-size: 96px; }
    p88 := Text { visible: false; width: w; text: root.text; wrap: word-wrap; font-family: "YS Music Headline"; font-weight: 700; font-size: 88px; }
    p80 := Text { visible: false; width: w; text: root.text; wrap: word-wrap; font-family: "YS Music Headline"; font-weight: 700; font-size: 80px; }
    p72 := Text { visible: false; width: w; text: root.text; wrap: word-wrap; font-family: "YS Music Headline"; font-weight: 700; font-size: 72px; }
    p64 := Text { visible: false; width: w; text: root.text; wrap: word-wrap; font-family: "YS Music Headline"; font-weight: 700; font-size: 64px; }
    p56 := Text { visible: false; width: w; text: root.text; wrap: word-wrap; font-family: "YS Music Headline"; font-weight: 700; font-size: 56px; }
    p48 := Text { visible: false; width: w; text: root.text; wrap: word-wrap; font-family: "YS Music Headline"; font-weight: 700; font-size: 48px; }
    p40 := Text { visible: false; width: w; text: root.text; wrap: word-wrap; font-family: "YS Music Headline"; font-weight: 700; font-size: 40px; }
    p32 := Text { visible: false; width: w; text: root.text; wrap: word-wrap; font-family: "YS Music Headline"; font-weight: 700; font-size: 32px; }
    w104 := Text { visible: false; text: root.longest; font-family: "YS Music Headline"; font-weight: 700; font-size: 104px; }
    w96 := Text { visible: false; text: root.longest; font-family: "YS Music Headline"; font-weight: 700; font-size: 96px; }
    w88 := Text { visible: false; text: root.longest; font-family: "YS Music Headline"; font-weight: 700; font-size: 88px; }
    w80 := Text { visible: false; text: root.longest; font-family: "YS Music Headline"; font-weight: 700; font-size: 80px; }
    w72 := Text { visible: false; text: root.longest; font-family: "YS Music Headline"; font-weight: 700; font-size: 72px; }
    w64 := Text { visible: false; text: root.longest; font-family: "YS Music Headline"; font-weight: 700; font-size: 64px; }
    w56 := Text { visible: false; text: root.longest; font-family: "YS Music Headline"; font-weight: 700; font-size: 56px; }
    w48 := Text { visible: false; text: root.longest; font-family: "YS Music Headline"; font-weight: 700; font-size: 48px; }
    w40 := Text { visible: false; text: root.longest; font-family: "YS Music Headline"; font-weight: 700; font-size: 40px; }
    w32 := Text { visible: false; text: root.longest; font-family: "YS Music Headline"; font-weight: 700; font-size: 32px; }

    property <length> top: compact ? 64px : 104px;
    property <length> bottom: compact ? 24px : 48px;
    property <int> lines: compact ? 2 : 4;
    pure function fits(word: length, text: length, s: length) -> bool {
        return s <= top && s >= bottom && word <= w && text <= min(h, lines * s * 1.25);
    }
    property <length> size:
          fits(w104.preferred-width, p104.preferred-height, 104px) ? 104px
        : fits(w96.preferred-width, p96.preferred-height, 96px) ? 96px
        : fits(w88.preferred-width, p88.preferred-height, 88px) ? 88px
        : fits(w80.preferred-width, p80.preferred-height, 80px) ? 80px
        : fits(w72.preferred-width, p72.preferred-height, 72px) ? 72px
        : fits(w64.preferred-width, p64.preferred-height, 64px) ? 64px
        : fits(w56.preferred-width, p56.preferred-height, 56px) ? 56px
        : fits(w48.preferred-width, p48.preferred-height, 48px) ? 48px
        : fits(w40.preferred-width, p40.preferred-height, 40px) ? 40px
        : fits(w32.preferred-width, p32.preferred-height, 32px) ? 32px
        : bottom;

    shown := Text {
        width: w;
        height: h;
        text: root.text;
        wrap: word-wrap;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-family: "YS Music Headline";
        font-size: root.size;
        font-weight: 700;
        color: #ffffff;
    }
    line := Text { visible: false; text: root.text; font-family: "YS Music Headline"; font-weight: 700; font-size: root.size; }
    // Кликабельна только сама надпись, а не пустое место вокруг.
    if root.link: TouchArea {
        width: min(w, line.preferred-width);
        height: min(h, shown.preferred-height);
        x: (w - self.width) / 2;
        y: (h - self.height) / 2;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Пункт меню волны (`VibeContextButton_menuItem`): поля 8 сверху и снизу, 12 по бокам, значок 20,
// между значком и подписью 12. У «Нравится» после лайка подпись и значок светлее
// (`menuItem_active`).
component VibeMenuItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    callback clicked;
    property <brush> ink: root.active || ta.has-hover ? #ffffffe6 : #ffffff80;
    height: 36px;
    border-radius: Theme.radius-size-m;
    background: ta.has-hover ? #ffffff14 : transparent;
    animate background { duration: App.motion ? 150ms : 0ms; }
    HorizontalLayout {
        padding-left: Theme.spacer-size-m;
        padding-right: Theme.spacer-size-m;
        spacing: Theme.spacer-size-m;
        VerticalLayout {
            alignment: center;
            Icon { source: root.icon; size: Theme.icon-size-xxs; colorize: root.ink; }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.font-size-label-m;
            font-weight: 500;
            color: root.ink;
            animate color { duration: App.motion ? 150ms : 0ms; }
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Меню волны под челкой (`VibeContextButton_menu`): по ширине пунктов, поля 10 сверху и снизу,
// 8 по бокам, фон — чёрный на 70%.
component VibeMenu inherits Rectangle {
    width: col.preferred-width;
    height: col.preferred-height;
    border-radius: Theme.radius-size-xl;
    background: Theme.controls-color-primary-on-default-enabled.transparentize(30%);
    TouchArea { }
    col := VerticalLayout {
        padding-top: Theme.spacer-size-s;
        padding-bottom: Theme.spacer-size-s;
        padding-left: Theme.spacer-size-xs;
        padding-right: Theme.spacer-size-xs;
        VibeMenuItem {
            text: App.wave-pinned ? T.t("Открепить") : T.t("Закрепить");
            icon: App.wave-pinned ? Icons.m-unpin : Icons.m-pin;
            clicked => { App.wave-menu-action("pin"); }
        }
        VibeMenuItem {
            text: T.t("Нравится");
            icon: App.wave-liked ? Icons.m-liked : Icons.m-like;
            active: App.wave-liked;
            clicked => { App.wave-menu-action("like"); }
        }
        if App.wave-share: VibeMenuItem {
            text: T.t("Поделиться");
            icon: Icons.m-share;
            clicked => { App.wave-menu-action("share"); }
        }
    }
}

// «Челка» над пятном: источник волны и отдельная круглая кнопка сброса. У волны, которую можно
// закрепить и добавить в Коллекцию, челка со стрелкой открывает меню, как VibeContextButton
// оригинала: оно под челкой по центру, на 4 ниже (`offsetOptions: 4`).
component ContextPill inherits Rectangle {
    in property <string> text;
    in property <bool> menu;
    in property <bool> menu-open;
    callback reset;
    callback toggle;
    height: 48px;
    property <length> btn: 48px;
    property <length> arrow: root.menu ? 24px : 0px;
    property <length> pill-w: min(label.preferred-width + 48px + arrow, root.width - btn - 4px);
    if root.menu && root.menu-open: VibeMenu {
        x: pill.x + (pill.width - self.width) / 2;
        y: root.height + 4px;
    }
    pill := Rectangle {
        x: (root.width - pill-w - 4px - btn) / 2;
        width: pill-w;
        border-radius: 24px;
        background: pill-ta.pressed ? #00000099 : pill-ta.has-hover ? #00000066 : #0000004d;
        animate background { duration: App.motion ? Theme.duration-transition : 0ms; }
        label := Text {
            x: 24px;
            width: parent.width - 48px - root.arrow;
            text: root.text;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-family: "YS Music Headline";
            font-size: Theme.font-size-headline-xs;
            font-weight: 700;
            color: Theme.logo-color-primary-player;
        }
        if root.menu: Icon {
            x: parent.width - 24px - 20px;
            source: Icons.arrow-down;
            size: 20px;
            colorize: Theme.logo-color-primary-player;
            transform-rotation: root.menu-open ? 180deg : 0deg;
        }
        pill-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                if root.menu {
                    root.toggle();
                } else {
                    root.reset();
                }
            }
        }
    }
    Rectangle {
        x: pill.x + pill.width + 4px;
        width: btn;
        border-radius: btn / 2;
        background: x-ta.pressed ? #00000099 : x-ta.has-hover ? #00000066 : #0000004d;
        animate background { duration: App.motion ? Theme.duration-transition : 0ms; }
        Icon { source: Icons.close-small; size: 24px; colorize: x-ta.has-hover ? #ffffffe6 : #ffffff80; }
        x-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.reset(); }
        }
    }
}

component TuneChip inherits Rectangle {
    in property <WaveOption> option;
    callback clicked;
    height: 36px;
    border-radius: self.height / 2;
    background: root.option.selected ? #ffffff : ta.has-hover ? #ffffff26 : #ffffff14;
    HorizontalLayout {
        padding-left: root.option.image.width > 0 ? 6px : 14px;
        padding-right: 14px;
        spacing: 8px;
        if root.option.image.width > 0: Cover {
            width: 24px;
            height: 24px;
            y: 6px;
            radius: 12px;
            source: root.option.image;
        }
        Text {
            text: root.option.name;
            vertical-alignment: center;
            overflow: elide;
            font-size: Theme.font-size-label-m;
            font-weight: 500;
            color: root.option.selected ? #000000 : #ffffffe6;
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Кнопка «Настроить» под Play, как VibeBlock_settingsButton у оригинала.
component TunePill inherits Rectangle {
    callback clicked;
    width: row.preferred-width;
    height: 40px;
    border-radius: self.height / 2;
    background: ta.has-hover ? #ffffff26 : #ffffff14;
    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 8px;
        alignment: center;
        Image {
            y: 12px;
            width: 16px;
            height: 16px;
            source: @image-url("../icons/tune.svg");
            colorize: #ffffffe6;
        }
        Text {
            text: T.t("Настроить");
            vertical-alignment: center;
            font-size: Theme.font-size-label-m;
            font-weight: 500;
            color: #ffffffe6;
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Настройки «Моей волны»: по варианту из каждой группы, выбор сразу перезапускает волну.
// Ширина 410, как у VibeSettings_popover; варианты по два в ряд.
// Не влезает в окно — группы листаются, заголовок остаётся на месте.
component WaveTune inherits Rectangle {
    in property <length> limit: 100000px;
    property <length> pad: 20px;
    property <length> cell: (self.width - 2 * self.pad - 8px) / 2;
    width: 410px;
    height: min(68px + self.groups-h, self.limit);
    clip: true;
    property <length> groups-h: self.rows-before(App.wave-settings.length);
    pure function rows-before(n: int) -> length {
        // У групп разное число вариантов, поэтому высота считается по каждой.
        (n > 0 ? self.group-h(0) : 0) + (n > 1 ? self.group-h(1) : 0) + (n > 2 ? self.group-h(2) : 0) + (n > 3 ? self.group-h(3) : 0)
    }
    pure function group-h(g: int) -> length {
        28px + ceil(App.wave-settings[g].options.length / 2) * 44px + 12px
    }
    border-radius: 16px;
    background: Theme.background-color-primary-enabled-popover;
    border-width: 1px;
    border-color: Theme.outline-color-primary-disabled;
    drop-shadow-blur: 20px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: #0000007a;
    TouchArea { }
    Text {
        x: root.pad;
        y: 20px;
        text: T.t("Настроить Мою волну");
        font-family: "YS Music Headline";
        font-size: Theme.font-size-headline-xs;
        font-weight: 700;
        color: Theme.controls-color-primary-text-enabled-variant;
    }
    flick := Flickable {
        y: 64px;
        height: root.height - 64px;
        content-height: root.groups-h + 4px;
        for group[g] in App.wave-settings: Rectangle {
            x: root.pad;
            y: root.rows-before(g);
            width: root.width - 2 * root.pad;
            height: root.group-h(g);
            Text {
                x: 0;
                y: 0;
                width: parent.width;
                text: group.name;
                horizontal-alignment: left;
                font-size: Theme.font-size-label-s;
                color: Theme.controls-color-primary-text-enabled;
            }
            for option[o] in group.options: TuneChip {
                x: mod(o, 2) * (root.cell + 8px);
                y: 28px + floor(o / 2) * 44px;
                width: root.cell;
                option: option;
                clicked => { App.tune-wave(g, o); }
            }
        }
    }
    if flick.content-height > flick.height: ScrollBar {
        y: flick.y;
        height: flick.height;
        content-y <=> flick.content-y;
        content-height: flick.content-height;
    }
}

export component WavePage inherits Rectangle {
    // Сколько окна за краями страницы сверху, справа и снизу (`ui/app.slint`): пятно краем
    // страницы не обрезается и доходит до краёв окна, как холст оригинала.
    in property <length> spill-top;
    in property <length> spill-right;
    in property <length> spill-bottom;
    // Раскладка оригинала: колесо — левые 40%, справа мета с отступами 24 и 48.
    property <length> wheel-w: root.width * 0.4;
    property <length> text-x: wheel-w + 24px;
    property <length> text-w: root.width - text-x - 48px;
    property <length> cx: text-x + text-w / 2;
    property <length> blob: root.width * 0.6 * 1.107;
    property <bool> paused: App.has-track && !App.playing;
    property <length> title-y: App.wave-context ? 84px : 98px;
    // Высота окна и сдвиги по замерам оригинала при 700–1100: плеер прижат к низу (H − 248),
    // заголовок и пятно — к середине; ниже 800 отступы меньше.
    property <length> wh: root.height + 20px;
    property <length> dp: max(wh - 248px, min(wh - 200px, 600px)) - 600px;
    property <length> dt: max(wh / 2 - 225px, min(wh / 2 - 209px, 191px)) - 191px;
    property <length> db: max(wh / 2 - 458px, min(wh / 2 - 442px, -42px)) + 42px;
    property <float> progress: App.duration > 0 ? App.position / App.duration : 0;
    property <float> drag-progress: -1;
    property <float> shown: drag-progress >= 0 ? drag-progress : progress;

    // Фото исполнителя (`VibePage_artistCover`): занимает блок меты от заголовка до плашки
    // плеера и прижато к его низу; надпись тогда уходит наверх, в полосу 64 px со сдвигом 16
    // (`textContainer_withCover`). Фото нет при высоте контейнера `vibe-page` ≤ 640 px
    // (`@container vibe-page (max-height: 640px)` → `VibePage_artistCover { display: none }`,
    // `750797f00b76a063.css`); контейнер на 44 px ниже окна (32 сверху и 12 снизу), так что
    // фото пропадает на окне ≤ 684 px.
    property <bool> with-cutout: App.has-track && !paused && App.has-cutout && wh > 684px;
    property <length> meta-top: title-y;
    property <length> art-h: 496px + dp - meta-top;
    // `VibeArtistCover_cover`: ширина min(100cqw, (100cqh − 16) · 5/4), соотношение 1,25,
    // поле 16 сверху; картинка вписана в него целиком.
    property <length> art-w: min(text-w, (art-h - 16px) * 1.25);
    property <length> art-box: art-w / 1.25;
    // Маска оригинала гаснет от 80% высоты блока до его низа; фото прижато к низу блока
    // и занимает `art-box − 16`, отсюда начало растворения в долях высоты фото.
    property <float> cutout-from: max(0, min(1, 1 - 0.2 * art-h / max(1px, art-box - 16px)));
    changed cutout-from => {
        if with-cutout {
            App.cutout-fade(self.cutout-from);
        }
    }

    // Холст анимации оригинала (`VibePage_vibeAnimation`, `width: 250%`): квадрат в 250% ширины
    // блока с названием, по его центру.
    property <length> canvas: text-w * 2.5;
    property <length> canvas-x: cx - canvas / 2;
    property <length> canvas-y: 284px + db - canvas / 2;
    // Видимая часть холста в долях: за краем окна шейдер считать незачем. Слева край —
    // сама страница: там меню, пятно под него не заходит.
    property <{x0: float, y0: float, x1: float, y1: float}> crop: {
        x0: max(0, -canvas-x / canvas),
        y0: max(0, (-spill-top - canvas-y) / canvas),
        x1: min(1, (root.width + spill-right - canvas-x) / canvas),
        y1: min(1, (root.height + spill-bottom - canvas-y) / canvas),
    };
    changed crop => { App.vibe-crop(crop.x0, crop.y0, crop.x1, crop.y1); }
    init => {
        App.vibe-crop(crop.x0, crop.y0, crop.x1, crop.y1);
        App.vibe-mount();
    }

    // Живое пятно: шейдер оригинала. Прозрачность 0,8 и проявление за секунду уже в кадре.
    if App.vibe-anim: Image {
        x: canvas-x + canvas * App.vibe-x;
        y: canvas-y + canvas * App.vibe-y;
        width: canvas * App.vibe-w;
        height: canvas * App.vibe-h;
        source: App.vibe-frame;
        image-fit: fill;
    }
    // Без движения и в «Лёгком» режиме: картинка оригинала, перекрашенная под трек.
    if !App.vibe-anim: Image {
        x: cx - blob / 2;
        y: 284px + db - blob / 2;
        width: blob;
        height: blob;
        source: App.blob;
        image-fit: contain;
        opacity: 0.8;
    }

    // Колесо вайбов: бесконечная лента, крутится колёсиком мыши.
    wheel := Rectangle {
        x: 0;
        y: 0;
        width: wheel-w;
        height: root.height;
        clip: true;

        property <int> n: App.wheel.length;
        property <int> per-view: max(4, min(9, floor(self.height / 106px)));
        property <length> slide-h: self.height / per-view;
        property <length> wrap-x: self.width - min(self.width * 0.8, 600px);
        property <bool> centering;
        property <float> offset: App.wheel-offset;
        animate offset { duration: App.motion && wheel.centering ? Theme.duration-transition : 0ms; easing: ease; }
        property <int> first: floor(offset) - ceil(per-view / 2);
        property <int> slot-count: per-view + 3;

        function move-to(target: float, center: bool) {
            wheel.centering = center;
            App.wheel-offset = target;
        }

        wheel-input := TouchArea {
            scroll-event(e) => {
                // Колесо проходит 0,3 прокрутки, как у оригинала (Swiper, mousewheel.sensitivity: .3):
                // в Windows щелчок теперь даёт пиксели Chromium. На Linux Slint даёт 60 px на щелчок —
                // там прежние 30 px.
                wheel.move-to(wheel.offset - e.delta-y * (App.linux ? 0.5 : 0.3) / wheel.slide-h, false);
                accept
            }
            for k in (wheel.n > 0 ? wheel.slot-count : 0): WheelSlot {
                // Меняем карточку, когда слот уже ушёл за край колеса.
                property <int> ordinal: k + ceil((wheel.first - k) / wheel.slot-count) * wheel.slot-count;
                property <int> idx: mod(mod(ordinal, wheel.n) + wheel.n, wheel.n);
                entry: App.wheel[idx];
                p: ordinal - wheel.offset;
                pointer-x: wheel-input.has-hover ? wheel-input.mouse-x - self.x : -1px;
                pointer-y: wheel-input.mouse-y - self.y;
                slide-h: wheel.slide-h;
                wrap-x: wheel.wrap-x;
                area-h: wheel.height;
                area-w: wheel.width;
                clicked => {
                    if abs(self.p) >= 2.5 { wheel.move-to(self.ordinal, true); }
                    else { App.play-wheel(self.idx); }
                }
            }
        }
    }

    // Источник: «Моя волна» — просто подпись; волна по треку, исполнителю или вайбу — «челка» со сбросом.
    if App.has-track && !App.wave-context: Text {
        x: text-x;
        y: 38px;
        width: text-w;
        text: App.source-title;
        horizontal-alignment: center;
        font-family: "YS Music Headline";
        font-size: Theme.font-size-headline-s;
        font-weight: 700;
        color: #ffff00;
    }
    // Сохраняем размер оригинала, пока заголовок помещается в одну строку.
    if !App.has-track || paused: Rectangle {
        x: text-x;
        y: 171px + dt;
        width: text-w;
        height: title.preferred-height;

        title-metrics := Text {
            visible: false;
            text: T.t("Моя волна");
            font-family: "YS Music Headline";
            font-size: 103px / App.ui-scale;
            font-weight: 700;
        }
        title := Text {
            width: parent.width;
            text: title-metrics.text;
            horizontal-alignment: center;
            font-family: title-metrics.font-family;
            font-size: title-metrics.font-size * min(1, self.width / max(1px, title-metrics.preferred-width));
            font-weight: title-metrics.font-weight;
            color: #ffffff;
        }
    }

    // Исполнитель крупно: клик открывает его страницу.
    if App.has-track && !paused: FitTitle {
        x: text-x;
        // С фото: середина полосы 64 px, текст в две строки свисает за неё, как в оригинале.
        y: with-cutout ? meta-top + 16px + 32px - self.height / 2 : title-y;
        width: text-w;
        height: with-cutout ? 2 * 64px * 1.25 : 382px + dp - title-y;
        compact: with-cutout;
        text: App.artists;
        longest: App.artists-longest;
        link: App.artist-list.length > 0;
        clicked => { App.open-current-artist(0); }
    }

    // Фото рисуется поверх надписи (в оригинале блок идёт после неё), под курсором растёт
    // до 1,01 от нижнего края (`VibeArtistCover_root:hover`, ease-in-out).
    if with-cutout: Rectangle {
        init => { App.cutout-fade(root.cutout-from); }
        x: text-x;
        y: meta-top;
        width: text-w;
        height: art-h;
        transform-origin: { x: self.width / 2, y: self.height };
        transform-scale: art-ta.has-hover ? 1.01 : 1;
        animate transform-scale { duration: App.motion ? Theme.duration-transition : 0ms; easing: ease-in-out; }
        if App.cutout.width > 0: Image {
            x: (parent.width - root.art-w) / 2;
            y: parent.height - root.art-box + 16px;
            width: root.art-w;
            height: root.art-box - 16px;
            source: App.cutout;
            image-fit: contain;
        }
        art-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { App.open-current-artist(0); }
        }
    }

    // Обложка открывает альбом трека, а не плеер на весь экран.
    if App.has-track: Cover {
        x: cx - 48px;
        y: 384px + dp;
        width: 96px;
        height: 96px;
        radius: Theme.radius-size-m;
        source: App.cover;
        TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { App.open-current-album(); } }
    }

    if App.has-track: HorizontalLayout {
        x: cx - (4 * 52px + min(346px, text-w - 4 * 52px)) / 2;
        y: 496px + dp;
        height: 64px;
        spacing: 4px;
        // Громкость: стеклянный ползунок над кнопкой, пока на ней курсор.
        Rectangle {
            y: 8px;
            width: 48px;
            height: 48px;
            property <bool> open: vol.hovered || vol-pop.hovered || bridge.has-hover;
            vol := GlassButton {
                scroll-volume: true;
                highlight-icon: self.hovered || vol-pop.hovered;
                icon: App.volume <= 0 ? Icons.volume-off : Icons.volume;
                clicked => { App.toggle-mute(); }
            }
            bridge := TouchArea {
                y: -4px;
                height: 4px;
                visible: parent.open;
            }
            vol-pop := VolumePopup {
                x: (parent.width - self.width) / 2;
                y: -4px - self.height;
                open: parent.open;
                glass: true;
            }
        }
        GlassButton { y: 8px; icon: App.disliked ? Icons.disliked : Icons.dislike; enabled: App.is-wave; clicked => { App.dislike(); } }
        // Плашка трека — она же полоса перемотки: закрашена слева по прогрессу.
        pill := Rectangle {
            width: min(346px, text-w - 4 * 52px);
            height: 64px;
            border-radius: 32px;
            background: #ffffff14;
            Rectangle {
                border-radius: 32px;
                clip: true;
                Rectangle {
                    x: 0;
                    width: parent.width * root.shown;
                    background: #ffffff14;
                }
            }
            Text {
                width: parent.width - 52px;
                text: App.title;
                horizontal-alignment: center;
                overflow: elide;
                font-family: "YS Music Headline";
                font-size: Theme.font-size-headline-xs;
                font-weight: 700;
                color: #ffffffb3;
            }
            pill-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                pointer-event(e) => {
                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                        root.drag-progress = max(0, min(1, self.mouse-x / self.width));
                    }
                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.drag-progress >= 0 {
                        App.seek(root.drag-progress * App.duration);
                        root.drag-progress = -1;
                    }
                }
                moved => {
                    if self.pressed {
                        root.drag-progress = max(0, min(1, self.mouse-x / self.width));
                    }
                }
            }
            // Подсказка времени: у бегунка при перемотке, у курсора при наведении.
            if pill-ta.has-hover || root.drag-progress >= 0: Rectangle {
                property <float> at: root.drag-progress >= 0 ? root.drag-progress : max(0, min(1, pill-ta.mouse-x / pill-ta.width));
                x: parent.width * at - self.width / 2;
                y: -32px;
                width: tip.preferred-width + 16px;
                height: 24px;
                border-radius: 12px;
                background: #000000b3;
                tip := Text {
                    text: App.format-time(at * App.duration) + " / " + App.format-time(App.duration);
                    font-size: Theme.font-size-label-xs;
                    font-weight: 500;
                    color: #ffffffe6;
                }
            }
        }
        GlassButton { y: 8px; icon: App.liked ? Icons.liked : Icons.like; clicked => { App.like(); } }
        more := GlassButton {
            y: 8px;
            icon: Icons.more;
            clicked => { App.open-track-menu(self.absolute-position.x + self.width / 2, self.absolute-position.y); }
        }
    }

    HorizontalLayout {
        x: cx - 88px;
        y: 580px + dp;
        width: 176px;
        height: 64px;
        spacing: 32px;
        BarButton {
            width: 24px; height: 24px; y: 20px;
            icon: Icons.prev; enabled: App.can-prev; smooth-color: true;
            clicked => { App.prev(); }
        }
        Rectangle {
            width: 64px;
            height: 64px;
            border-radius: 32px;
            background: App.playing ? #ffffff40 : Theme.logo-color-primary-player;
            animate background { duration: App.motion ? Theme.duration-transition : 0ms; easing: ease; }
            Icon {
                source: App.playing ? Icons.pause-big : Icons.play-big;
                size: 32px;
                colorize: App.playing ? (play-ta.has-hover ? #e6e6e6 : #ffffff80) : #000;
                animate colorize { duration: App.motion ? Theme.duration-transition : 0ms; easing: ease; }
            }
            play-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { App.play-pause(); } }
        }
        BarButton {
            width: 24px; height: 24px; y: 20px;
            icon: Icons.next; enabled: App.has-track; smooth-color: true;
            clicked => { App.next(); }
        }
    }

    // Версия в правом нижнем углу, как у официального приложения.
    Rectangle {
        x: parent.width - self.width;
        y: parent.height - 38px;
        width: ver.preferred-width + 16px;
        height: 26px;
        border-radius: 16px;
        background: #ffffff14;
        ver := Text {
            text: App.version;
            font-size: Theme.font-size-label-s;
            font-weight: 500;
            color: #ffffff80;
        }
    }

    // Челка со своим меню — поверх заголовка и плеера; клик мимо меню закрывает его.
    if App.wave-menu-open && App.wave-menu: TouchArea {
        clicked => { App.wave-menu-open = false; }
    }
    if App.has-track && App.wave-context: ContextPill {
        x: text-x;
        y: 24px;
        width: text-w;
        text: App.source-title;
        menu: App.wave-menu;
        menu-open: App.wave-menu-open;
        reset => {
            App.wave-menu-open = false;
            App.reset-wave();
        }
        toggle => { App.wave-menu-open = !App.wave-menu-open; }
    }

    // Настройки «Моей волны» — у неё самой и у волны «Под занятие» (сиды `user:onyourwave`
    // или `activity:*`, как у кнопки настроек оригинала), пока она не играет.
    tune := TunePill {
        x: cx - self.width / 2;
        y: 664px + dp;
        visible: (!App.wave-context || App.wave-tunable) && (!App.has-track || paused);
        clicked => { App.open-wave-settings(); }
    }
    if App.wave-settings-open: TouchArea {
        clicked => { App.wave-settings-open = false; }
    }
    // Панель справа от кнопки; в узком окне прижимается к правому краю.
    if App.wave-settings-open: WaveTune {
        limit: min(480px, parent.height - 32px);
        x: min(tune.x + tune.width + 12px, parent.width - self.width - 16px);
        y: clamp(tune.y + tune.height - self.height, 16px, parent.height - self.height - 16px);
    }
}
