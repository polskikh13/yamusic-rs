// Нижний плеер.

import { Theme } from "theme.slint";
import { Icons, Icon, BarButton, Cover, ArtistLinks, ExplicitMark } from "widgets.slint";
import { App, T } from "state.slint";
import { VolumePopup } from "popups.slint";

component TransportButton inherits BarButton {
    grow-on-hover: true;
    ink-active: Theme.controls-color-secondary-text-enabled-variant;
}

component BarPlayButton inherits TransportButton {
    width: 40px;
    height: 40px;
    icon-size: 40px;
    icon: App.playing ? Icons.pause-filled : Icons.play-filled;
    ink: Theme.logo-color-primary-player;
    ink-hover: self.ink;
    ink-off: self.ink;
    clicked => { App.play-pause(); }
}

// Нижний плеер. Фон — цвет обложки (hsl с яркостью 20%), прогресс закрашивает фон слева направо.
export component PlayerBar inherits Rectangle {
    property <float> progress: App.duration > 0 ? App.position / App.duration : 0;
    property <float> drag-progress: -1;
    property <float> shown: drag-progress >= 0 ? drag-progress : progress;
    property <brush> ink: #ffffff80;
    property <brush> ink-off: #ffffff14;
    property <bool> on: App.has-track;
    property <length> c: self.width / 2;
    property <bool> vol-open: vol-btn.hovered || vol-pop.hovered;
    property <bool> dragging: drag-progress >= 0;
    // Полоса и бегунок видны при наведении на плеер или на зону перемотки.
    property <bool> show-progress: on && (bar-ta.has-hover || seek-ta.has-hover || dragging);
    property <float> rail-alpha: show-progress ? 1 : 0;
    animate rail-alpha { duration: App.motion && !dragging ? Theme.duration-transition : 0ms; easing: ease; }
    property <float> tip-alpha: on && (seek-ta.has-hover || dragging) ? 1 : 0;
    animate tip-alpha { duration: App.motion && !dragging ? Theme.duration-transition : 0ms; easing: ease; }
    property <float> hover-progress: max(0, min(1, seek-ta.mouse-x / root.width));

    inner := Rectangle {
        border-radius: Theme.radius-size-l;
        border-width: 1px;
        border-color: #ffffff0a;
        background: on ? App.tint : Theme.background-color-primary-enabled-player;
        clip: true;
        animate background { duration: App.motion ? Theme.duration-transition : 0ms; }

        if on: Rectangle {
            x: 0;
            width: parent.width * shown;
            height: parent.height;
            background: #ffffff0d;
        }
        // Полоса прогресса сверху: видна при наведении на плеер.
        if rail-alpha > 0: Rectangle {
            y: 0;
            height: 4px;
            background: #ffffff.with-alpha(0.12 * root.rail-alpha);
            Rectangle {
                x: 0;
                width: parent.width * shown;
                background: seek-ta.has-hover || dragging ? Theme.controls-color-primary-default-enabled : #ffffff29;
                opacity: root.rail-alpha;
            }
        }

        bar-ta := TouchArea {
            mouse-cursor: on ? MouseCursor.pointer : MouseCursor.default;
            clicked => {
                if on {
                    App.open-fullscreen(0);
                }
            }

            if on: Cover {
                x: 9px;
                y: 8px;
                width: 64px;
                height: 64px;
                radius: Theme.radius-size-s;
                background: #ffffff14;
                source: App.cover;
                property <float> reveal: cover-ta.has-hover ? 1 : 0;
                animate reveal { duration: App.motion ? Theme.duration-transition : 0ms; easing: ease; }
                if reveal > 0: Rectangle {
                    opacity: reveal;
                    background: #00000033;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 22px;
                        background: #1a1a1ae6;
                        Icon { source: Icons.fullscreen; size: 24px; colorize: #ffffff; }
                    }
                }
                cover-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { App.open-fullscreen(0); }
                }
            }

            if on: Rectangle {
                x: 81px;
                y: 19px;
                width: c - 188px - self.x - 16px;
                height: 20px;
                HorizontalLayout {
                    alignment: start;
                    spacing: 4px;
                    title := Text {
                        text: App.title;
                        overflow: elide;
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                        font-size: Theme.font-size-label-m;
                        font-weight: 500;
                        color: #ffffff;
            if title-ta.has-hover: Rectangle {
                x: 0;
                y: (parent.height + parent.font-size) / 2 + 1px;
                width: min(parent.width, parent.preferred-width);
                height: 1px;
                background: parent.color;
            }
                        title-ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { App.open-current-album(); }
                        }
                    }
                    if App.track-version != "": Text {
                        text: App.track-version;
                        overflow: elide;
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                        font-size: Theme.font-size-label-m;
                        font-weight: 500;
                        color: #ffffff80;
                    }
                    if App.track-explicit: ExplicitMark { y: 1px; ink: #ffffff80; }
                    more := Rectangle {
                        width: 36px;
                        height: 20px;
                        Icon {
                            source: Icons.more-small;
                            size: 20px;
                            colorize: more-ta.has-hover || App.menu-open ? #ffffffe6 : #ffffff80;
                            animate colorize { duration: App.motion ? Theme.duration-transition : 0ms; easing: ease; }
                        }
                        more-ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { App.open-track-menu(more.absolute-position.x + 18px, more.absolute-position.y); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            // Каждый исполнитель — отдельная ссылка.
            if on: ArtistLinks {
                x: 81px;
                y: 40px;
                width: min(self.content-width, c - 188px - self.x - 16px);
                height: 20px;
                names: App.artist-list;
                ink: #ffffff80;
                ink-hover: #ffffffe6;
                clicked(i) => { App.open-current-artist(i); }
            }

            BarButton { x: c - 188px; y: 18px; width: 44px; height: 44px; icon: App.disliked ? Icons.disliked : Icons.dislike; tip: T.t("Не нравится"); enabled: on; clicked => { App.dislike(); } }
            TransportButton { x: c - 128px; y: 24px; icon: Icons.shuffle; tip: T.t("Перемешать"); enabled: on && !App.is-wave; active: App.shuffle; ink-hover: self.ink; clicked => { App.toggle-shuffle(); } }
            TransportButton { x: c - 80px; y: 18px; width: 44px; height: 44px; icon: Icons.prev-small; icon-size: 20px; tip: T.t("Предыдущая песня"); enabled: on && App.can-prev; clicked => { App.prev(); } }
            BarPlayButton { x: c - 32px; y: 20px; }
            TransportButton { x: c + 12px; y: 18px; width: 44px; height: 44px; icon: Icons.next-small; icon-size: 20px; tip: T.t("Следующая песня"); enabled: on; clicked => { App.next(); } }
            TransportButton { x: c + 72px; y: 24px; icon: App.repeat == 2 ? Icons.repeat-one : Icons.repeat; tip: App.repeat == 2 ? T.t("Повтор трека") : T.t("Повтор"); enabled: on; active: App.repeat > 0; ink-hover: self.ink; clicked => { App.cycle-repeat(); } }
            BarButton { x: c + 120px; y: 18px; width: 44px; height: 44px; icon: App.liked ? Icons.liked : Icons.like; tip: T.t("Нравится"); enabled: on; clicked => { App.like(); } }

            // По высоте кнопок справа (y 24, 32 px), чтобы надпись стояла на их середине.
            if on && App.track-format != "": Text {
                x: parent.width - 201px - self.width;
                y: 24px;
                height: 32px;
                text: App.track-format;
                vertical-alignment: center;
                font-size: Theme.font-size-label-s;
                font-weight: 500;
                color: #ffffff66;
            }
            BarButton { x: parent.width - 193px; y: 24px; icon: Icons.lyrics; tip: T.t("Текст песни"); enabled: on && App.has-lyrics; clicked => { App.open-fullscreen(2); } }
            BarButton { x: parent.width - 145px; y: 24px; icon: Icons.queue; tip: T.t("Очередь"); enabled: on; clicked => { App.open-fullscreen(1); } }
            BarButton { x: parent.width - 97px; y: 24px; icon: Icons.settings; tip: T.t("Настройки звука"); active: App.eq-open; clicked => { App.eq-open = !App.eq-open; } }
            vol-btn := BarButton {
                x: parent.width - 49px;
                y: 24px;
                icon: App.volume <= 0 ? Icons.volume-off : Icons.volume;
                scroll-volume: true;
                active: false;
                ink: vol-open ? #ffffffe6 : #ffffff80;
                clicked => { App.toggle-mute(); }
            }
        }
    }

    // Перемотка: зона 16 px по верхнему краю (6 px над плеером и 10 px внутри), тянуть можно по всей ширине.
    seek-ta := TouchArea {
        x: 0;
        y: -6px;
        width: root.width;
        height: 16px;
        enabled: on;
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.drag-progress = max(0, min(1, self.mouse-x / root.width));
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.drag-progress >= 0 {
                App.seek(root.hover-progress * App.duration);
                root.drag-progress = -1;
            }
            if e.kind == PointerEventKind.cancel { root.drag-progress = -1; }
        }
        moved => {
            if self.pressed {
                root.drag-progress = max(0, min(1, self.mouse-x / root.width));
            }
        }
    }

    if rail-alpha > 0: Rectangle {
        opacity: root.rail-alpha;
        x: root.width * shown - self.width / 2;
        y: 2px - self.height / 2;
        width: 12px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.controls-color-primary-default-enabled;
    }
    if tip-alpha > 0: Rectangle {
        opacity: root.tip-alpha;
        property <float> at: dragging ? shown : hover-progress;
        x: max(0px, min(root.width - self.width, root.width * at - self.width / 2));
        y: -32px;
        width: time.preferred-width + 16px;
        height: 24px;
        border-radius: 12px;
        background: #000000b3;
        time := Text {
            text: App.format-time(at * App.duration) + " / " + App.format-time(App.duration);
            font-size: Theme.font-size-label-xs;
            font-weight: 500;
            color: #ffffffe6;
        }
    }

    vol-pop := VolumePopup {
        x: root.width - 49px + 16px - self.width / 2;
        y: 24px - self.height;
        open: vol-open;
    }
}

// Мини-плеер: окно ужато до плашки поверх всех окон. Тянется за любое место,
// двойной клик возвращает обычное окно.
export component MiniPlayer inherits Rectangle {
    property <bool> on: App.has-track;
    background: on ? App.tint : Theme.background-color-primary-enabled-player;
    animate background { duration: App.motion ? Theme.duration-transition : 0ms; }

    ta := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                App.drag-window();
            }
        }
        double-clicked => { App.toggle-mini(); }
        // Колёсико над плашкой меняет громкость, как над ползунком в большом плеере.
        scroll-event(e) => {
            App.set-volume(App.wheel-volume(e.delta-y));
            accept
        }

        if on: Rectangle {
            x: 0;
            y: parent.height - 2px;
            width: App.duration > 0 ? parent.width * App.position / App.duration : 0;
            height: 2px;
            background: Theme.controls-color-primary-default-enabled;
        }
        if on: Cover {
            x: 12px;
            y: 12px;
            width: 64px;
            height: 64px;
            radius: Theme.radius-size-s;
            background: #ffffff14;
            source: App.cover;
        }
        VerticalLayout {
            x: on ? 88px : 16px;
            width: parent.width - self.x - 184px;
            alignment: center;
            spacing: 2px;
            Text {
                text: on ? App.title : App.app-name;
                overflow: elide;
                font-size: Theme.font-size-label-m;
                font-weight: 500;
                color: #ffffff;
            }
            if on: Text {
                text: App.artists;
                overflow: elide;
                font-size: Theme.font-size-label-m;
                color: #ffffff80;
            }
        }

        BarButton { x: parent.width - 180px; y: 26px; width: 36px; height: 36px; icon: App.liked ? Icons.liked : Icons.like; tip: T.t("Нравится"); icon-size: 20px; enabled: on; clicked => { App.like(); } }
        TransportButton { x: parent.width - 136px; y: 28px; icon: Icons.prev-small; icon-size: 20px; enabled: on && App.can-prev; clicked => { App.prev(); } }
        BarPlayButton { x: parent.width - 96px; y: 24px; enabled: on; }
        TransportButton { x: parent.width - 48px; y: 28px; icon: Icons.next-small; icon-size: 20px; enabled: on; clicked => { App.next(); } }

        // Громкость при наведении: значок выключает звук, полоску можно тянуть.
        if ta.has-hover || vol-ta.pressed: BarButton {
            x: parent.width - 172px;
            y: 2px;
            width: 24px;
            height: 24px;
            icon: App.volume <= 0 ? Icons.volume-off : Icons.volume;
            scroll-volume: true;
            icon-size: 16px;
            clicked => { App.toggle-mute(); }
        }
        Rectangle {
            x: parent.width - 144px;
            y: 2px;
            width: 80px;
            height: 24px;
            visible: ta.has-hover || vol-ta.pressed;
            property <float> v: max(0, min(1, App.volume));
            Rectangle { y: 10px; height: 4px; border-radius: 2px; background: #ffffff33; }
            Rectangle { x: 0; y: 10px; width: parent.width * v; height: 4px; border-radius: 2px; background: #ffffffcc; }
            Rectangle {
                x: parent.width * v - 5px;
                y: 7px;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: vol-ta.has-hover || vol-ta.pressed ? Theme.controls-color-primary-default-enabled : #ffffff;
            }
            vol-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        App.set-volume(max(0, min(1, self.mouse-x / self.width)));
                    }
                }
                moved => {
                    if self.pressed {
                        App.set-volume(max(0, min(1, self.mouse-x / self.width)));
                    }
                }
            }
        }
        if ta.has-hover: BarButton { x: parent.width - 52px; y: 2px; width: 24px; height: 24px; icon: Icons.fullscreen; icon-size: 16px; clicked => { App.toggle-mini(); } }
        if ta.has-hover: BarButton { x: parent.width - 28px; y: 2px; width: 24px; height: 24px; icon: Icons.close-xs; icon-size: 16px; clicked => { App.close(); } }
    }
}
