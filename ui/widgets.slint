    in property <image> id-logo;
    in property <image> id-logo-dark;
    in property <image> id-check;
    in property <image> id-close;
    in property <image> id-account;
    in property <image> id-settings;
    in property <image> id-support;
    in property <image> id-language;
    in property <image> id-appearance;
    in property <image> id-dark;
    in property <image> id-system;
    in property <image> search;
    in property <image> arrow-left;
    in property <image> arrow-right;
    in property <image> pin;
    in property <image> trailer;
    in property <image> explicit;
    in property <image> plus-badge;
    in property <image> add;
    in property <image> note;
    in property <image> more-small;
    in property <image> prev-small;
    in property <image> next-small;
    in property <image> play-filled;
    in property <image> pause-filled;
    in property <image> play-small;
    in property <image> trailer-small;
    in property <image> like-small;
    in property <image> best;
    in property <image> liked-small;
    in property <image> pin-small;
    in property <image> pin-filled-small;
    in property <image> arrow-left-small;
    in property <image> arrow-right-small;
    in property <image> exclamation;
    in property <image> close-small;
    in property <image> bucket-small;
    in property <image> more-xs;
    in property <image> play-big;
    in property <image> pause-big;
    in property <image> pause-filled-xs;
    in property <image> play-filled-xs;
    in property <image> crown;
    in property <image> chart-up;
    in property <image> chart-down;
    in property <image> chart-new;
    in property <image> chart-same;
    in property <image> add-large;
    in property <image> pencil;
    in property <image> download-small;
    in property <image> fullscreen;
    in property <image> arrow-down;
    in property <image> queue-m;
    in property <image> lyrics-m;
    in property <image> more-m;
    in property <image> like-m;
    in property <image> liked-m;
    in property <image> play-m;
    in property <image> pause-m;
    in property <image> shuffle-small;
