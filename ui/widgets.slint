// Общие элементы: иконки из sprite.svg, кнопки, обложки, поле ввода, заглушки загрузки.

import { Theme } from "theme.slint";
import { App } from "state.slint";

// Картинки задаёт Rust при запуске из спрайта официального приложения.
export global Icons {
    in property <image> logo;
    in property <image> logo-dark;
    // Знак без надписи — для свёрнутого навбара.
    in property <image> logo-mark;
    in property <image> logo-mark-dark;
    in property <image> nav-search;
    in property <image> nav-wave;
    in property <image> nav-trends;
    in property <image> nav-trends-selected;
    in property <image> nav-concerts;
    in property <image> nav-concerts-selected;
    in property <image> nav-nonmusic;
    in property <image> nav-nonmusic-selected;
    in property <image> nav-collection;
    in property <image> nav-collection-selected;
    in property <image> play;
    in property <image> pause;
    in property <image> next;
    in property <image> prev;
    in property <image> like;
    in property <image> liked;
    in property <image> dislike;
    in property <image> disliked;
    in property <image> shuffle;
    in property <image> repeat;
    in property <image> repeat-one;
    in property <image> lyrics;
    in property <image> queue;
    in property <image> settings;
    in property <image> volume;
    in property <image> volume-off;
    in property <image> more;
