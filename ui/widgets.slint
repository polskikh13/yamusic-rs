export component Icon inherits Image {
    in property <length> size: 24px;
    width: size;
    height: size;
    image-fit: contain;
}

export component HoverIcon inherits Rectangle {
    in property <image> source <=> glyph.source;
    in property <brush> colorize <=> glyph.colorize;
    in property <float> alpha: 1;
    in property <length> size: 24px;
    in property <bool> zoomed;
    property <float> zoom: zoomed ? 1.05 : 1;
    animate zoom { duration: App.motion ? Theme.duration-transition : 0ms; easing: ease; }
    width: size;
    height: size;
    // Округляем, как Skia при масштабе 1, чтобы значок не дёргался при наведении.
    pure function pixel-offset(pos: length) -> length { return round(pos / 1phx) * 1phx - pos; }
    glyph := Icon {
        x: root.pixel-offset(root.absolute-position.x);
        y: root.pixel-offset(root.absolute-position.y);
        size: root.size;
        opacity: root.alpha;
        transform-scale: root.zoom;
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> size: 24px;
    in property <brush> tint: Theme.controls-color-secondary-on-outline-enabled;
    in property <brush> hover-color: Theme.controls-color-primary-text-enabled-variant;
    in property <bool> enabled: true;
    callback clicked;
    width: size + 8px;
    height: size + 8px;
    Icon {
        source: icon;
        size: size;
        colorize: !enabled ? Theme.controls-color-primary-default-disabled : ta.has-hover ? hover-color : tint;
        animate colorize { duration: App.motion ? Theme.duration-transition : 0ms; }
    }
    ta := TouchArea {
        enabled: enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component BarButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 24px;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <brush> ink: #ffffff80;
    in property <brush> ink-hover: Theme.controls-color-secondary-text-hovered;
    in property <brush> ink-active: Theme.controls-color-primary-default-enabled;
    in property <bool> grow-on-hover;
    in property <bool> smooth-color: grow-on-hover;
    in property <brush> ink-off: #ffffff14;
    /// Колёсико над кнопкой меняет громкость.
    in property <bool> scroll-volume;
    in property <string> tip;
    out property <bool> hovered: ta.has-hover;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: self.width / 2;
    property <bool> tip-hot: ta.has-hover && root.tip != "";
    changed tip-hot => {
        if self.tip-hot {
            App.tip = root.tip;
            App.tip-x = self.absolute-position.x + self.width / 2;
            App.tip-y = self.absolute-position.y - 6px;
            App.tip-above = true;
        } else if App.tip == root.tip {
            App.tip = "";
        }
    }
    HoverIcon {
        source: icon;
        size: root.icon-size;
        zoomed: root.grow-on-hover && ta.has-hover && root.enabled;
        colorize: !enabled ? ink-off : active ? ink-active : ta.has-hover ? ink-hover : ink;
        animate colorize { duration: App.motion && root.smooth-color ? Theme.duration-transition : 0ms; easing: ease; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
        scroll-event(e) => {
            if !root.scroll-volume {
                return reject;
            }
            App.set-volume(App.wheel-volume(e.delta-y));
            accept
        }
    }
}

// Подсказка поверх всего окна: появляется, если курсор задержался на месте.
export component TipLayer inherits Rectangle {
    property <string> pending: App.tip;
    property <string> shown;
    changed pending => { self.shown = ""; }
    Timer {
        interval: 600ms;
        running: root.pending != "" && root.shown != root.pending;
        triggered => { root.shown = root.pending; }
    }
    if root.shown != "": Rectangle {
        property <length> w: min(label.preferred-width + 16px, 320px);
        x: App.tip-above ? clamp(App.tip-x - self.w / 2, 4px, root.width - self.w - 4px) : App.tip-x;
        y: max(4px, App.tip-above ? App.tip-y - self.height : App.tip-y - self.height / 2);
        width: self.w;
        height: 28px;
        border-radius: Theme.radius-size-s;
        background: Theme.background-color-primary-enabled-popover;
        border-width: 1px;
        border-color: Theme.outline-color-primary-disabled;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000040;
        label := Text {
            x: 8px;
            width: parent.width - 16px;
            text: root.shown;
            overflow: elide;
            vertical-alignment: center;
            font-size: Theme.font-size-label-s;
            font-weight: 500;
            color: Theme.controls-color-primary-text-enabled-variant;
        }
    }
}

// Круглая кнопка на сером фоне (лайк, закреп, «ещё» в шапке страницы).
export component CircleButton inherits Rectangle {
    in property <image> icon;
    in property <length> diameter: 40px;
    in property <length> icon-size: 24px;
    in property <brush> icon-color: Theme.controls-color-secondary-on-default-enabled;
    callback clicked;
    width: diameter;
    height: diameter;
    border-radius: diameter / 2;
    background: ta.pressed ? Theme.controls-color-secondary-default-pressed
        : ta.has-hover ? Theme.controls-color-secondary-default-hovered
        : Theme.controls-color-secondary-default-enabled;
    animate background { duration: App.motion ? Theme.duration-transition : 0ms; }
    Icon { source: icon; size: icon-size; colorize: icon-color; }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component PillButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> primary;
    callback clicked;
    height: 40px;
    width: label.preferred-width + (has-icon ? 24px + 4px : 0px) + 2 * 16px;
    border-radius: self.height / 2;
    background: primary
        ? (ta.pressed ? Theme.controls-color-primary-default-pressed : ta.has-hover ? Theme.controls-color-primary-default-hovered : Theme.controls-color-primary-default-enabled)
        : (ta.pressed ? Theme.controls-color-secondary-default-pressed : ta.has-hover ? Theme.controls-color-secondary-default-hovered : Theme.controls-color-secondary-default-enabled);
    animate background { duration: App.motion ? Theme.duration-transition : 0ms; }
    HorizontalLayout {
        alignment: center;
        spacing: 4px;
        if has-icon: Icon {
            y: (parent.height - self.height) / 2;
            source: icon;
            size: 24px;
            colorize: primary ? Theme.controls-color-primary-on-default-enabled : Theme.controls-color-secondary-on-default-enabled;
        }
        label := Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.font-size-label-m;
            font-weight: 500;
            color: primary ? Theme.controls-color-primary-on-default-enabled : Theme.controls-color-secondary-on-default-enabled;
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component Shimmer inherits Rectangle {
    background: Theme.background-color-primary-enabled-shimmer;
}

// Обложка с image-fit: cover. Если картинка декодирована под экран (±2%), она рисуется
// без сглаживания: вид тот же, а билинейной выборки на каждом кадре нет. Иначе — сглаживание.
export component Pic inherits Image {
    image-fit: cover;
    property <float> ratio: max(self.width / 1px * App.dpr / max(1, self.source.width), self.height / 1px * App.dpr / max(1, self.source.height));
    image-rendering: self.ratio > 0.98 && self.ratio < 1.02 ? pixelated : smooth;
}

export component Cover inherits Rectangle {
    in property <image> source;
    in property <length> radius: Theme.radius-size-m;
    in property <bool> round;
    // Прозрачность картинки без слоя: opacity на самой Cover в Skia стоит отдельного слоя.
    in property <float> alpha: 1;
    border-radius: round ? self.width / 2 : radius;
    clip: true;
    // Заглушка только до загрузки: под картинкой полупрозрачная заливка — лишний проход по пикселям.
    background: root.source.width > 0 ? transparent : Theme.controls-color-secondary-default-enabled;
    Pic {
        width: parent.width;
        height: parent.height;
        source: root.source;
        opacity: root.alpha;
    }
}

// Поле ввода: Ctrl+A/C/V/X/Z работают и на русской раскладке.
export component Field inherits TextInput {
    selection-background-color: #5c8ff566;
    selection-foreground-color: self.color;
    callback escape();
    // Пока поле с фокусом, горячие клавиши окна его не трогают (src/gui/keys.rs).
    changed has-focus => {
        App.text-focused = self.has-focus;
        if self.has-focus {
            App.text-x = self.absolute-position.x;
            App.text-y = self.absolute-position.y;
            App.text-w = self.width;
            App.text-h = self.height;
        }
    }
    property <int> blur: App.blur-tick;
    changed blur => {
        if self.has-focus {
            self.clear-focus();
        }
    }
    // Выключенное поле (как поля названия и описания плейлиста после правки) отдаёт фокус.
    changed enabled => {
        if !self.enabled && self.has-focus {
            self.clear-focus();
        }
    }
    key-pressed(e) => {
        if e.text == Key.Escape {
            self.escape();
            return reject;
        }
        if !e.modifiers.control || e.modifiers.alt {
            return reject;
        }
        if e.text == "ф" || e.text == "Ф" || e.text == "a" || e.text == "A" {
            self.select-all();
            return accept;
        }
        if e.text == "с" || e.text == "С" {
            self.copy();
            return accept;
        }
        if e.text == "м" || e.text == "М" {
            self.paste();
            return accept;
        }
        if e.text == "ч" || e.text == "Ч" {
            self.cut();
            return accept;
        }
        if e.text == "я" || e.text == "Я" {
            self.undo();
            return accept;
        }
        reject
    }
}

// Исполнители через запятую, каждый открывается отдельно.
export component ArtistLinks inherits Rectangle {
    in property <[string]> names;
    in property <length> font-size: Theme.font-size-label-m;
    in property <brush> ink: Theme.controls-color-primary-text-enabled;
    in property <brush> ink-hover: Theme.controls-color-primary-text-enabled-variant;
    in property <bool> links: true;
    out property <length> content-width: row.preferred-width;
    callback clicked(int);
    clip: true;
    row := HorizontalLayout {
        alignment: start;
        for n[i] in root.names: Text {
            text: i < root.names.length - 1 ? n + ", " : n;
            vertical-alignment: center;
            horizontal-stretch: 0;
            font-size: root.font-size;
            font-weight: 500;
            color: ta.has-hover && root.links ? root.ink-hover : root.ink;
            animate color { duration: App.motion ? Theme.duration-transition : 0ms; }
            ta := TouchArea {
                enabled: root.links;
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.clicked(i); }
            }
        }
    }
}

// Значок «!» у трека с ограничением: при наведении показывает пояснение.
export component ExplicitMark inherits Rectangle {
    in property <brush> ink: Theme.controls-color-primary-text-enabled;
    in property <length> size: 18px;
    width: size;
    height: size;
    Image {
        width: root.size;
        height: root.size;
        source: Icons.exclamation;
        colorize: ta.has-hover ? Theme.controls-color-primary-text-enabled-variant : root.ink;
        image-fit: contain;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        changed has-hover => {
            if self.has-hover {
                App.hint-x = root.absolute-position.x + root.width / 2;
                App.hint-y = root.absolute-position.y;
                App.hint-open = true;
            } else {
                App.hint-open = false;
            }
        }
        clicked => {
            App.hint-x = root.absolute-position.x + root.width / 2;
            App.hint-y = root.absolute-position.y;
            App.hint-open = true;
        }
    }
}

export component NavCircle inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: !enabled ? Theme.controls-color-secondary-default-disabled : ta.has-hover ? Theme.controls-color-secondary-default-hovered : Theme.controls-color-secondary-default-enabled;
    animate background { duration: App.motion ? 150ms : 0ms; }
    Icon { source: icon; size: 20px; colorize: enabled ? Theme.controls-color-secondary-on-default-enabled : Theme.controls-color-secondary-on-default-disabled; }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Назад и вперёд по истории, как в браузере.
export component NavArrows inherits HorizontalLayout {
    spacing: 8px;
    NavCircle { icon: Icons.arrow-left-small; enabled: App.can-back; clicked => { App.go-back(); } }
    NavCircle { icon: Icons.arrow-right-small; enabled: App.can-forward; clicked => { App.go-forward(); } }
}

// Плавное появление содержимого: страницы, меню, окна. Работает при создании элемента.
export component Fade inherits Rectangle {
    in property <length> rise: 0px;
    property <float> k: App.motion ? 0 : 1;
    init => { k = 1; }
    animate k { duration: App.motion ? 220ms : 0ms; easing: ease-out; }
    Rectangle {
        y: (1 - root.k) * root.rise;
        width: root.width;
        height: root.height;
        opacity: root.k;
        @children
    }
}

// Полоса прокрутки поверх страницы. Ставится последней, на место Flickable; `content-y`
// связывается с ним в обе стороны.
// Как у списков оригинала (`VirtualScroll`, полоса `::-webkit-scrollbar` 24 px): бегунок с
// прозрачной рамкой 8 px, то есть видно 8 px в 8 px от края; длина — доля видимой части, но
// не меньше 50 px вместе с рамкой. Виден, пока страница едет, и 200 мс после (`isScrolling`
// у react-virtuoso), под курсором другого цвета. Тянуть можно и невидимый, как в Chromium.
//
// PgUp/PgDn и Home/End листают страницу. Клавиши Slint отдаёт только элементу с фокусом,
// поэтому фокус держит полоса; поле ввода с фокусом (`field-focused`) оставляет их себе.
export component ScrollBar inherits Rectangle {
    in-out property <length> content-y;
    in property <length> content-height;
    in property <bool> field-focused;
    property <length> range: max(0px, root.content-height - root.height);
    // Бегунок вместе с рамкой.
    property <length> size: max(50px, root.height * min(1, root.height / max(1px, root.content-height)));
    property <float> value: root.range > 0 ? max(0, min(1, -root.content-y / root.range)) : 0;
    // Страница у Chromium — 87,5% высоты (`kMinFractionToStepWhenPaging`, на Windows и Linux
    // без ограничения перекрытия), в целых пикселях.
    property <length> page: max(1px, floor(root.height * 0.875 / 1px) * 1px);
    property <bool> scrolling;
    changed content-y => {
        root.scrolling = true;
        // `restart()` не запускает остановленный таймер: сначала включаем, потом отсчёт заново.
        idle.running = true;
        idle.restart();
    }
    idle := Timer {
        interval: 200ms;
        running: false;
        triggered => {
            self.running = false;
            root.scrolling = false;
        }
    }

    thumb := TouchArea {
        x: root.width - 24px;
        y: (root.height - root.size) * root.value;
        width: 24px;
        height: root.size;
        enabled: root.range > 0;
        property <length> grab-y;
        property <float> grab-value;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                self.grab-y = self.absolute-position.y + self.mouse-y;
                self.grab-value = root.value;
            }
        }
        moved => {
            if self.pressed && root.height > root.size {
                root.content-y = -root.range * max(0, min(1, self.grab-value
                    + (self.absolute-position.y + self.mouse-y - self.grab-y) / (root.height - root.size)));
            }
        }
        Rectangle {
            x: 8px;
            y: 8px;
            width: 8px;
            height: parent.height - 16px;
            border-radius: 4px;
            visible: root.range > 0 && (root.scrolling || thumb.pressed);
            background: thumb.has-hover || thumb.pressed ? Theme.surface-color-primary-enabled-entity : Theme.controls-color-primary-default-disabled;
        }
    }

    keys := FocusScope {
        // Иначе первый щелчок по странице ушёл бы на то, чтобы забрать фокус.
        focus-on-click: false;
        // Плеер на весь экран держит фокус ради Esc, его не отбираем.
        init => {
            if !App.fullscreen {
                self.focus();
            }
        }
        key-pressed(e) => {
            // Как в Chromium: с Shift, Alt и Win не листают, с Ctrl — только Home и End.
            if e.modifiers.shift || e.modifiers.alt || e.modifiers.meta {
                return reject;
            }
            if e.text == Key.Home {
                root.content-y = 0px;
                return accept;
            }
            if e.text == Key.End {
                root.content-y = -root.range;
                return accept;
            }
            if e.modifiers.control {
                return reject;
            }
            if e.text == Key.PageDown {
                root.content-y = max(-root.range, root.content-y - root.page);
                return accept;
            }
            if e.text == Key.PageUp {
                root.content-y = min(0px, root.content-y + root.page);
                return accept;
            }
            reject
        }
    }
    // Фокус возвращается странице, когда его отпускает поле ввода или закрывается плеер
    // на весь экран: иначе клавиши некому принять.
    changed field-focused => {
        if !root.field-focused && !App.fullscreen {
            keys.focus();
        }
    }
    property <bool> fullscreen: App.fullscreen;
    changed fullscreen => {
        if !root.fullscreen {
            keys.focus();
        }
    }
}
